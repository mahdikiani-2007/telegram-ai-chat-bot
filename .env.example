# Copy to .env and fill in. NEVER commit .env (gitignored).
# Panel rule: runtime settings live in the DB, never here — env is bootstrap only.

# --- Required ---
TELEGRAM_TOKEN=
# CHAT_API_KEY (or legacy AGNES_API_KEY fallback) — chat LLM bearer key
CHAT_API_KEY=

# --- Bot admins (panel) ---
# Comma-separated numeric Telegram user IDs. First ID is the OWNER
# (unremovable, owner-only actions). Legacy ADMIN_ID still works as fallback.
ADMIN_IDS=123456789
# ADMIN_ID=123456789

# --- Optional: second bot, APIs, features ---
# TELEGRAM_TOKEN_LIGHT=
# IMAGE_API_KEY=
# TAVILY_API_KEY=
# TAVILY_DAILY_LIMIT=40
# INSTAGRAM_COOKIES_FILE=
# YOUTUBE_COOKIES_FILE=
# YOUTUBE_MAX_HEIGHT=1080
# LOCAL_BOT_API_URL=http://localhost:8081
# TG_API_ID= TG_API_HASH= TG_SESSION_NAME=yt_uploader
# IG_RELAY_USERNAME= IG_RELAY_PASSWORD=
# DATA_DIR=/data
# DIGEST_HOUR_IRAN=9 DIGEST_MINUTE_IRAN=0 BACKUP_HOUR_IRAN=4
