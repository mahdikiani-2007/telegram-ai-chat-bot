# Telegram Bot Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Agnes AI API Keys (for Chat and Image Generation)
AGNES_API_KEY=your_agnes_api_key_here

# Optional: Separate API keys for Chat and Image (if not provided, AGNES_API_KEY will be used)
CHAT_API_KEY=your_chat_api_key_here
IMAGE_API_KEY=your_image_api_key_here

# Optional: Model Configuration
CHAT_API_BASE=https://apihub.agnes-ai.com/v1
AGNES_BASE=https://apihub.agnes-ai.com/v1
CHAT_MODEL=agnes-2.0-flash
IMAGE_MODEL=agnes-image-2.0-flash

# Optional: Memory & Behavior Settings
RECENT_HISTORY=8
SUMMARIZE_THRESHOLD=40
SUMMARIZE_BATCH=30
STREAM_EDIT_INTERVAL=1.2

# Optional: Data Directory (for Hugging Face Spaces)
# DATA_DIR=/data
